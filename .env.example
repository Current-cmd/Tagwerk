# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required by docker compose; pick a long random one
NEO4J_PASSWORD=
HF_TOKEN=
# Leave empty to run speech and vision inside the API process.
GPU_WORKER_URL=
DATA_DIR=./data
DATA_DATE=2026-11-26
# Venue coordinates for weather when uploads carry no GPS
SITE_LAT=48.137
SITE_LON=11.575
REPLAY_MODE=false
# Bearer token for the API and the web pages (open a page once with ?token=<API_TOKEN>).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))". The API refuses to start without it...
API_TOKEN=
# ...unless TAGWERK_DEV=1 (local development, auth off).
TAGWERK_DEV=0
# /api/scan make_project=<name> writes seed/projects/<name>/
ALLOW_PROJECT_CREATE=0
MAX_UPLOAD_MB=500
MAX_UPLOAD_FILES=50
